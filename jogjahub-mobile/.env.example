# Salin file ini menjadi .env lalu sesuaikan nilainya.
# Expo SDK 54 otomatis membaca variabel ber-prefix EXPO_PUBLIC_* (tanpa plugin tambahan).

# Android emulator: http://10.0.2.2:8000/api/v1
# Perangkat fisik: http://<IP-LAN-KOMPUTER>:8000/api/v1 (jalankan backend dengan `php artisan serve --host=0.0.0.0`)
# Produksi: https://api.jogjahub.com/api/v1
EXPO_PUBLIC_API_BASE_URL=https://api.jogjahub.com/api/v1

# Google Maps API key (dipakai saat fitur peta diimplementasikan)
EXPO_PUBLIC_MAPS_API_KEY=your_google_or_leaflet_maps_key
