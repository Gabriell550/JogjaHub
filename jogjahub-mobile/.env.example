# Salin file ini menjadi .env lalu isi dengan IP komputer yang menjalankan backend.
# HP dan komputer backend harus berada di Wi-Fi yang sama.
# Contoh: http://192.168.1.33:8000/api/v1
# Setelah mengubah .env, restart Metro dengan cache bersih: npx expo start -c
EXPO_PUBLIC_API_URL=http://192.168.1.33:8000/api/v1

# Google Maps API key (dipakai saat fitur peta diimplementasikan)
EXPO_PUBLIC_MAPS_API_KEY=your_google_or_leaflet_maps_key
