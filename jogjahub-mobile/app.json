{
  "expo": {
    "name": "JogjaHub",
    "slug": "jogjahub-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#f8f9ff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jogjahub.app"
    },
    "android": {
      "package": "com.jogjahub.app"
    },
    "plugins": [
      "expo-font",
      "expo-status-bar"
    ],
    "experiments": {
      "tsconfigPaths": true
    }
  }
}
